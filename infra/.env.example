# PostgreSQL Backend Database
DATABASE_URL=jdbc:postgresql://postgres-backend:5432/mdeo
DATABASE_USER=mdeo
DATABASE_PASSWORD=changeme_in_production

# Published application images for docker-compose-prod.yaml and docker-compose-quickstart.yaml
MDEO_IMAGE_PREFIX=ghcr.io/mde-optimiser
MDEO_IMAGE_TAG=latest

# Separate Backend Database Credentials (optional, for production)
# If set, these override DATABASE_USER/PASSWORD for the backend database
BACKEND_DB_USER=mdeo
BACKEND_DB_PASSWORD=changeme_in_production

# Script Execution Service Database
SCRIPT_EXECUTION_DATABASE_URL=jdbc:postgresql://postgres-script:5432/mdeo
SCRIPT_EXECUTION_DATABASE_USER=mdeo
SCRIPT_EXECUTION_DATABASE_PASSWORD=changeme_in_production

# Separate Executions Database Credentials (optional, for production)
# If set, these override DATABASE_USER/PASSWORD for the executions database
SCRIPT_DB_USER=mdeo
SCRIPT_DB_PASSWORD=changeme_in_production
MODEL_TRANSFORMATION_DB_USER=mdeo
MODEL_TRANSFORMATION_DB_PASSWORD=changeme_in_production

# Script Execution Configuration
EXECUTION_TIMEOUT_MS=300000
SCRIPT_EXECUTION_SERVICE_URL=http://script-execution:8080
SCRIPT_EXECUTION_BACKEND_URL=http://backend:8080

# Model Transformation Execution Configuration
MODEL_TRANSFORMATION_EXECUTION_SERVICE_URL=http://model-transformation-execution:8080
TRANSFORMATION_EXECUTION_DATABASE_URL=jdbc:postgresql://postgres-model-transformation:5432/mdeo
TRANSFORMATION_EXECUTION_BACKEND_URL=http://backend:8080

# Session configuration
SESSION_MAX_IDLE_SECONDS=604800
SESSION_MAX_ABSOLUTE_SECONDS=15552000
COOKIE_SECURE=true
COOKIE_SAMESITE=Strict

# JWT configuration
# JWT_EXPIRATION_SECONDS covers request-scoped service tokens.
# JWT_EXECUTION_EXPIRATION_SECONDS covers the token an execution node holds for the whole run; it
# must outlive the longest expected execution, otherwise the node cannot report its final state.
JWT_EXPIRATION_SECONDS=3600
JWT_EXECUTION_EXPIRATION_SECONDS=604800

# CORS
CORS_ALLOWED_HOSTS=your-domain.com

# Admin user (change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_in_production

# Plugin URL configuration
PLUGIN_BASE_URL=workbench:8080

# Plugin service host for nginx, one per registered plugin service
PLUGIN_METAMODEL_SERVICE=http://service-metamodel:3000
PLUGIN_MODEL_SERVICE=http://service-model:3000
PLUGIN_SCRIPT_SERVICE=http://service-script:3000
PLUGIN_MODEL_TRANSFORMATION_SERVICE=http://service-model-transformation:3000
PLUGIN_CONFIG_SERVICE=http://service-config:3000
PLUGIN_CONFIG_OPTIMIZATION_SERVICE=http://service-config-optimization:3000
PLUGIN_CONFIG_MDEO_SERVICE=http://service-config-mdeo:3000
PLUGIN_CSV_SERVICE=http://service-csv:3000
PLUGIN_MODEL_CSV_SERVICE=http://service-model-csv:3000
BACKEND_SERVICE=http://backend:8080

# Git access
# Where the browser-facing git authorization screen and the credential helper's
# token endpoint are served. Both are mounted at these paths and advertised in
# the setup commands the workbench shows, so the two cannot drift apart.
GIT_OAUTH_AUTHORIZE_PATH=/oauth/authorize
GIT_OAUTH_TOKEN_PATH=/api/oauth/token
# The SSH port, and how clients should reach it. Set GIT_SSH_PUBLIC_HOST when
# SSH is served from a different host than the workbench, and
# GIT_SSH_PUBLICLY_REACHABLE=false in a deployment that keeps the port
# internal - the workbench then stops offering an SSH clone URL nobody can use.
GIT_SSH_PORT=2222
#GIT_SSH_PUBLIC_HOST=
GIT_SSH_PUBLICLY_REACHABLE=true
